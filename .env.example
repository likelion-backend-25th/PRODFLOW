# DB 컨테이너 초기화 설정 (MySQL 컨테이너용)
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# JWT 시크릿키, 어세스토큰, 리프레쉬토큰 만료기한(30분, 14일)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=
JWT_REFRESH_TOKEN_EXPIRATION=

# application.yaml DB url 값
MYSQL_DB_HOST=
MYSQL_DB_PORT=

# AWS S3 (품목 도면 업로드)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# Gmail SMTP
MAIL_USERNAME=
MAIL_PASSWORD=

# 공공데이터포털 공휴일 api 인증키
HOLIDAY_API_KEY=

# 스마트택배(Tracker) 배송 조회 API 키
SHIPMENT_TRACKING_API_KEY=

# PortOne API 인증키
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
# PORTONE_WEBHOOK_URL은 로컬의 경우 ngrok으로 설정 뒤 해당 url로 해야함
PORTONE_WEBHOOK_URL=